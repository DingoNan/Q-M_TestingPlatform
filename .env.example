# ===== Q·M 测试平台 一键部署环境变量 =====
# 复制本文件为 .env 后按需修改，docker compose 会自动读取同目录的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=qm_root
MYSQL_DATABASE=qm_testing
MYSQL_USER=qm_testing
MYSQL_PASSWORD=qm_testing

# ---------- Redis ----------
# 留空则 Redis 不启用密码（仅 docker 内网可访问，足够安全）
REDIS_PASSWORD=

# ---------- Django ----------
# 生产环境务必保持 false
DJANGO_DEBUG=false
