# ===== BlackBagTest 一键部署环境变量 =====
# 复制本文件为 .env 后按需修改，docker compose 会自动读取同目录的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=blackbag_root
MYSQL_DATABASE=blackbag
MYSQL_USER=blackbag
MYSQL_PASSWORD=blackbag

# ---------- Redis ----------
# 留空则 Redis 不启用密码（仅 docker 内网可访问，足够安全）
REDIS_PASSWORD=

# ---------- Django ----------
# 生产环境务必保持 false
DJANGO_DEBUG=false
