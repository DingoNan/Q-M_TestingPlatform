# ===== Q·M 测试平台 根仓库 =====

# ---------- 敏感 / 本地配置（.env.example 才入库） ----------
.env
.env.*
!.env.example

# ---------- IDE ----------
.idea/
.vscode/
*.swp

# ---------- 编辑器/脚本产生的备份文件（勿入库） ----------
*.bak
*.bak.*
*.orig

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- 日志 ----------
*.log

# ---------- 前端 ----------
frontend/node_modules/
frontend/dist/
# 构建时把旧 dist 原子改名留作回滚点（如 dist.bak_before_build / dist_keep_<时间>），属产物不入库
frontend/dist.*/
frontend/dist_*/
frontend/.env.local
# 隔离出来的历史遗留资源（旧 logo auto.png、废弃页 cart.html 等），仅供排查追溯，不入库
frontend/_legacy_residual/
frontend/coverage/
frontend/tests/e2e/videos/

# ---------- 后端 Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
# ★★ 绝不可写裸的 env/ 或 ENV/：Windows 文件系统大小写不敏感，会连
#    frontend/src/views/env/（环境配置页源码共 6 个文件）一起忽略，
#    导致它们从未被 add 进版本库（2026-09-22 发现并修复）。
#    改为锚定「仓库根」与「backend/」两层。
/env/
/ENV/
backend/env/
backend/ENV/
*.egg-info/
.eggs/
backend/media/
backend/staticfiles/

# 构建缓存（Docker 基础镜像构建用，几百MB不宜入库）
backend/.buildcache/

# ---------- 测试产物（注意：不能用 report/，会误伤 frontend/src/views/report 源码目录） ----------
*.jtl
/allure-results/
/.jmeter/

# ---------- 打包 / 发布产物（体积大，禁止入库） ----------
# 压测客户端产物（QM_Test.exe，约 59MB）与 packages.zip(27MB) 曾误入库，已从 git 历史中剔除，
# 此处补规则防止再次被 add 进来（磁盘上的本地文件不受影响）。
*.exe
backend/packages.zip

# ---------- 会话内临时产物（提交信息草稿 / 探针输出等，不入库） ----------
_COMMIT_MSG*.txt
_cm_v*.txt
_gitprobe*.txt

# 根目录下的「验证/探针输出」（如 _p0_3_verify.txt / _p1_e2e.txt / _p1_*_probe.txt）。
# 这些是本地闸门与取证的运行日志，属于过程证据而非源码 —— 体积不大但会迅速堆积，
# 且每条都带时间戳与本机路径，入库只会给 review 添噪声。
# ★ 注意写的是 `/` 开头的**根锚定**模式：不锚定的话会命中 backend/apps/... 下的同名文件。
/_*_verify.txt
/_p[0-9]*_*.txt
/_*_probe.txt
/_*_console*.txt
